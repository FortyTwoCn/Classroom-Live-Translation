{
  "name": "classroom-live-translation-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:actual-http": "node tests/e2e/actual-http.mjs",
    "test:real-services": "node tests/e2e/actual-browser-real-services.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0",
    "ws": "^8.22.0"
  }
}
